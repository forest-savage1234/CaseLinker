{
  "$id": "https://caselinker.example/proposal/v4/disclosure-decision-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "v4 proposal disclosure decision v1",
  "type": "object",
  "additionalProperties": false,
  "x-caselinker-invariants": ["eligibility_is_not_disclosure", "deny_without_policy"],
  "properties": {
    "schema_version": {"const": "1.0", "type": "string"},
    "contract_kind": {"const": "disclosure_decision", "type": "string"},
    "request_id": {"type": "string", "pattern": "^dreq_[a-z0-9][a-z0-9._-]{2,127}$"},
    "decision_id": {"type": "string", "pattern": "^ddec_[a-z0-9][a-z0-9._-]{2,127}$"},
    "principal_id": {"type": "string", "pattern": "^prin_[a-z0-9][a-z0-9._-]{2,127}$"},
    "organization_id": {"type": "string", "pattern": "^org_[a-z0-9][a-z0-9._-]{2,127}$"},
    "audience": {
      "type": "string",
      "enum": ["internal_review", "approved_research", "public_aggregate"]
    },
    "purpose": {"type": "string", "minLength": 1},
    "requested_fields": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "channel": {"type": "string", "enum": ["export", "ui", "api"]},
    "jurisdiction": {"type": "string", "minLength": 1},
    "data_subject_role": {"type": "string", "minLength": 1},
    "vulnerability_classification": {"type": "string", "minLength": 1},
    "procedural_status": {"type": "string", "minLength": 1},
    "correction_state": {"type": "string", "minLength": 1},
    "source_restrictions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "collection_policy": {"type": "string", "minLength": 1},
    "granularity": {"type": "string", "enum": ["field", "record", "aggregate"]},
    "time_window": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {"type": "string", "format": "calendar-date"},
        "end": {"type": ["string", "null"], "format": "calendar-date"}
      },
      "required": ["start", "end"]
    },
    "outcome": {"type": "string", "enum": ["denied", "authorized", "minimized", "pending"]},
    "policy_version": {
      "type": "string",
      "pattern": "^$|^[a-z]+_[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "policy_result": {
      "type": "string",
      "enum": ["authorized", "denied", "minimized", "pending"]
    },
    "research_eligible": {"type": "boolean"},
    "treat_eligible_as_disclosed": {"type": "boolean"},
    "transformations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimization": {"type": "boolean"},
        "pseudonymization": {"type": "boolean"},
        "aggregation": {"type": "boolean"},
        "redaction": {"type": "boolean"},
        "watermarking": {"type": "boolean"}
      },
      "required": [
        "minimization",
        "pseudonymization",
        "aggregation",
        "redaction",
        "watermarking"
      ]
    },
    "expiry": {"type": ["string", "null"], "format": "utc-date-time"},
    "revocation_state": {
      "type": "string",
      "enum": ["not_applicable", "not_revoked", "revoked"]
    },
    "decision_reason": {"type": "string", "minLength": 1},
    "authority": {"type": "string", "minLength": 1},
    "audit_event_id": {"type": "string", "pattern": "^aud_[a-z0-9][a-z0-9._-]{2,127}$"},
    "request_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "required": [
    "schema_version",
    "contract_kind",
    "request_id",
    "decision_id",
    "principal_id",
    "organization_id",
    "audience",
    "purpose",
    "requested_fields",
    "channel",
    "jurisdiction",
    "data_subject_role",
    "vulnerability_classification",
    "procedural_status",
    "correction_state",
    "source_restrictions",
    "collection_policy",
    "granularity",
    "time_window",
    "outcome",
    "policy_version",
    "policy_result",
    "research_eligible",
    "treat_eligible_as_disclosed",
    "transformations",
    "expiry",
    "revocation_state",
    "decision_reason",
    "authority",
    "audit_event_id",
    "request_digest"
  ]
}
