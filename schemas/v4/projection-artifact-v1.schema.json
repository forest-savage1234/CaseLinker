{
  "$id": "https://caselinker.example/proposal/v4/projection-artifact-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "v4 proposal projection artifact v1",
  "type": "object",
  "additionalProperties": false,
  "x-caselinker-invariants": ["projection_not_authoritative"],
  "properties": {
    "schema_version": {"const": "1.0", "type": "string"},
    "contract_kind": {"const": "projection_artifact", "type": "string"},
    "artifact_id": {"type": "string", "pattern": "^proj_[a-z0-9][a-z0-9._-]{2,127}$"},
    "kind": {"type": "string", "enum": ["cac_ntriples", "claim_card", "evidence_pack"]},
    "digest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authoritative": {"type": "boolean"}
  },
  "required": [
    "schema_version",
    "contract_kind",
    "artifact_id",
    "kind",
    "digest_sha256",
    "authoritative"
  ]
}
