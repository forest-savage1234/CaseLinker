{
  "$id": "https://caselinker.example/proposal/v4/identity-hypothesis-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "v4 proposal identity hypothesis v1",
  "type": "object",
  "additionalProperties": false,
  "x-caselinker-invariants": ["similarity_is_not_identity", "no_blind_transitivity"],
  "properties": {
    "schema_version": {"const": "1.0", "type": "string"},
    "contract_kind": {"const": "identity_hypothesis", "type": "string"},
    "hypothesis_id": {"type": "string", "pattern": "^hyp_[a-z0-9][a-z0-9._-]{2,127}$"},
    "left_id": {"type": "string", "pattern": "^evt_[a-z0-9][a-z0-9._-]{2,127}$"},
    "right_id": {"type": "string", "pattern": "^evt_[a-z0-9][a-z0-9._-]{2,127}$"},
    "state": {
      "type": "string",
      "enum": ["possibly_same", "confirmed_same", "confirmed_different", "unresolved"]
    },
    "positive_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "negative_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "creates_canonical_identity": {"type": "boolean"},
    "inference_method": {
      "type": "string",
      "enum": ["reviewer_comparison", "transitive_closure"]
    }
  },
  "required": [
    "schema_version",
    "contract_kind",
    "hypothesis_id",
    "left_id",
    "right_id",
    "state",
    "positive_evidence",
    "negative_evidence",
    "creates_canonical_identity",
    "inference_method"
  ]
}
