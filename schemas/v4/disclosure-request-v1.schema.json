{
  "$id": "https://caselinker.example/proposal/v4/disclosure-request-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "v4 proposal disclosure request v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0", "type": "string"},
    "contract_kind": {"const": "disclosure_request", "type": "string"},
    "request_id": {"type": "string", "pattern": "^dreq_[a-z0-9][a-z0-9._-]{2,127}$"},
    "principal_id": {"type": "string", "pattern": "^prin_[a-z0-9][a-z0-9._-]{2,127}$"},
    "organization_id": {"type": "string", "pattern": "^org_[a-z0-9][a-z0-9._-]{2,127}$"},
    "jurisdiction": {"type": "string", "minLength": 1},
    "audience": {
      "type": "string",
      "enum": ["internal_review", "approved_research", "public_aggregate"]
    },
    "purpose": {"type": "string", "minLength": 1},
    "requested_fields": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "channel": {"type": "string", "enum": ["export", "ui", "api"]}
  },
  "required": [
    "schema_version",
    "contract_kind",
    "request_id",
    "principal_id",
    "organization_id",
    "jurisdiction",
    "audience",
    "purpose",
    "requested_fields",
    "channel"
  ]
}
