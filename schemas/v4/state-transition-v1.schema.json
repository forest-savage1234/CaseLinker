{
  "$id": "https://caselinker.example/proposal/v4/state-transition-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "v4 proposal state transition v1",
  "type": "object",
  "additionalProperties": false,
  "x-caselinker-invariants": ["legal_transition"],
  "properties": {
    "schema_version": {"const": "1.0", "type": "string"},
    "contract_kind": {"const": "state_transition", "type": "string"},
    "machine": {
      "type": "string",
      "enum": [
        "source_version",
        "candidate_claim",
        "accepted_claim",
        "identity_hypothesis",
        "review_task",
        "research_artifact",
        "disclosure_request",
        "publication",
        "federation_package",
        "legacy_assertion"
      ]
    },
    "subject_id": {"type": "string", "pattern": "^[a-z]+_[a-z0-9][a-z0-9._-]{2,127}$"},
    "from_state": {"type": "string", "minLength": 1},
    "to_state": {"type": "string", "minLength": 1},
    "actor_kind": {"type": "string", "enum": ["reviewer", "system", "policy"]},
    "reason_code": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "minLength": 1},
    "audit_event_id": {"type": "string", "pattern": "^aud_[a-z0-9][a-z0-9._-]{2,127}$"},
    "guard_code": {"type": "string", "minLength": 1},
    "two_person_control": {"type": "boolean"},
    "side_effects": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "required": [
    "schema_version",
    "contract_kind",
    "machine",
    "subject_id",
    "from_state",
    "to_state",
    "actor_kind",
    "reason_code",
    "idempotency_key",
    "audit_event_id",
    "guard_code",
    "two_person_control",
    "side_effects"
  ]
}
