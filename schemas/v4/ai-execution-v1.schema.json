{
  "$id": "https://caselinker.example/proposal/v4/ai-execution-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "v4 proposal AI execution provenance v1",
  "type": "object",
  "additionalProperties": false,
  "x-caselinker-invariants": ["ai_cannot_publish", "ai_no_self_review"],
  "properties": {
    "schema_version": {"const": "1.0", "type": "string"},
    "contract_kind": {"const": "ai_execution", "type": "string"},
    "execution_id": {"type": "string", "pattern": "^aiex_[a-z0-9][a-z0-9._-]{2,127}$"},
    "provider": {"type": "string", "minLength": 1},
    "model_identity": {"type": "string", "minLength": 1},
    "model_version": {"type": "string", "minLength": 1},
    "parameters_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution_environment": {"type": "string", "minLength": 1},
    "prompt_identity": {"type": "string", "minLength": 1},
    "allowed_input_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "retrieved_artifact_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z]+_[a-z0-9][a-z0-9._-]{2,127}$"}
    },
    "tool_calls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "args_digest"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "args_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "structured_output": {"type": "object"},
    "validation_result": {"type": "string", "minLength": 1},
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "amount_millionths"],
      "properties": {
        "currency": {"type": "string", "minLength": 1},
        "amount_millionths": {"type": "integer", "minimum": 0}
      }
    },
    "timing_ms": {"type": "integer", "minimum": 0},
    "resulting_canonical_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z]+_[a-z0-9][a-z0-9._-]{2,127}$"}
    },
    "structured_output_valid": {"type": "boolean"},
    "policy_decision": {"type": "string", "minLength": 1},
    "egress_class": {"type": "string", "enum": ["none", "minimized", "blocked"]},
    "reproducibility_limitation": {"type": "string", "minLength": 1},
    "reviewer_disposition": {
      "type": "string",
      "enum": ["pending", "accepted", "rejected", "self_approved"]
    },
    "disposition": {"type": "string", "enum": ["proposed", "rejected", "published"]}
  },
  "required": [
    "schema_version",
    "contract_kind",
    "execution_id",
    "provider",
    "model_identity",
    "model_version",
    "parameters_digest",
    "execution_environment",
    "prompt_identity",
    "allowed_input_digest",
    "retrieved_artifact_ids",
    "tool_calls",
    "structured_output",
    "validation_result",
    "cost",
    "timing_ms",
    "resulting_canonical_ids",
    "structured_output_valid",
    "policy_decision",
    "egress_class",
    "reproducibility_limitation",
    "reviewer_disposition",
    "disposition"
  ]
}
