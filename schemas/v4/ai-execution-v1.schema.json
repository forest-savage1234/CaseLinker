{
  "$id": "https://caselinker.example/proposal/v4/ai-execution-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "v4 proposal AI execution provenance v1",
  "type": "object",
  "additionalProperties": false,
  "x-caselinker-invariants": ["ai_cannot_publish", "ai_no_self_review"],
  "properties": {
    "schema_version": {"const": "1.0", "type": "string"},
    "contract_kind": {"const": "ai_execution", "type": "string"},
    "execution_id": {"type": "string", "pattern": "^aiex_[a-z0-9][a-z0-9._-]{2,127}$"},
    "provider": {"type": "string", "minLength": 1},
    "model_identity": {"type": "string", "minLength": 1},
    "model_version": {"type": "string", "minLength": 1},
    "parameters_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution_environment": {"type": "string", "minLength": 1},
    "prompt_identity": {"type": "string", "minLength": 1},
    "allowed_input_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tool_calls": {"type": "array", "items": {"type": "object"}},
    "structured_output_valid": {"type": "boolean"},
    "policy_decision": {"type": "string", "minLength": 1},
    "egress_class": {"type": "string", "enum": ["none", "minimized", "blocked"]},
    "reproducibility_limitation": {"type": "string", "minLength": 1},
    "reviewer_disposition": {
      "type": "string",
      "enum": ["pending", "accepted", "rejected", "self_approved"]
    },
    "disposition": {"type": "string", "enum": ["proposed", "rejected", "published"]}
  },
  "required": [
    "schema_version",
    "contract_kind",
    "execution_id",
    "provider",
    "model_identity",
    "model_version",
    "parameters_digest",
    "execution_environment",
    "prompt_identity",
    "allowed_input_digest",
    "tool_calls",
    "structured_output_valid",
    "policy_decision",
    "egress_class",
    "reproducibility_limitation",
    "reviewer_disposition",
    "disposition"
  ]
}
